# Choose one browser runtime: local, browserbase, anchor, or cdp.
VUDA_BROWSER_PROVIDER=local

# Browserbase (required only when VUDA_BROWSER_PROVIDER=browserbase)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Reuse a Browserbase Context to persist cookies, local storage, and login state.
BROWSERBASE_CONTEXT_ID=
# Optional Browserbase create-session fields, for example region or keepAlive.
VUDA_BROWSERBASE_SESSION_JSON={}

# Anchor Browser (required only when VUDA_BROWSER_PROVIDER=anchor)
ANCHOR_API_KEY=
# Optional: create/reuse a persistent authenticated Anchor profile.
# VUDA_ANCHOR_SESSION_JSON={"browser":{"profile":{"name":"vuda","persist":true}}}
VUDA_ANCHOR_SESSION_JSON={}

# Any existing Chromium CDP endpoint (required only for provider=cdp)
VUDA_CDP_URL=

# Optional account/session import for every provider. Use either or both cookie inputs.
# Cookie format: [{"name":"session","value":"...","domain":"example.com","path":"/"}]
VUDA_COOKIES_FILE=
VUDA_COOKIES_JSON=

# Local Playwright storage state. Relative paths resolve from VUDA's working directory.
VUDA_STORAGE_STATE_PATH=.vuda/storage-state.json
VUDA_PERSIST_STORAGE_STATE=false

# Timeouts (milliseconds)
VUDA_DEFAULT_TIMEOUT=15000
VUDA_NAVIGATION_TIMEOUT=15000
VUDA_SELECTOR_TIMEOUT=12000
VUDA_STABILITY_WAIT=5000
VUDA_UI_UPDATE_WAIT=1000
VUDA_PERFORMANCE_THRESHOLD=15000
VUDA_INTERACTION_DELAY=500
