{
  "name": "visual-ui-debug-agent-mcp",
  "version": "1.0.3",
  "description": "Visual UI testing and debugging tools for MCP clients, powered by Playwright",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "vuda": "dist/index.js",
    "visual-ui-debug-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/index.js",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "dev": "npm run build && npm start",
    "init-repo": "node scripts/init-repo.js",
    "watch": "tsc --watch",
    "check:assets": "node scripts/check-readme-assets.mjs",
    "test": "npm run check:assets && npm run build && node scripts/test-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samihalawa/visual-ui-debug-agent-mcp.git"
  },
  "homepage": "https://github.com/samihalawa/visual-ui-debug-agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/samihalawa/visual-ui-debug-agent-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jimp": "^1.6.1",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "shx": "^0.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vuda",
    "visual",
    "ui",
    "debug",
    "agent",
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "ai",
    "vision",
    "web",
    "testing",
    "automation",
    "playwright",
    "glama",
    "ui-testing",
    "visual-testing",
    "autonomous",
    "ui-debugging",
    "screenshot",
    "browser-automation",
    "e2e-testing",
    "claude",
    "anthropic"
  ],
  "author": "Sami Halawa",
  "license": "ISC"
}
